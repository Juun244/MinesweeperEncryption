  <diagram name="복호화 구성도 (v3)" id="2041996539">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="암호문&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(IV ∥ C1 ∥ C2 ∥ …)&lt;/font&gt;" vertex="1">
          <mxGeometry x="0" y="0" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="IV 분리 후&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;16바이트 블록 분할&lt;/font&gt;" vertex="1">
          <mxGeometry x="0" y="100" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="8×16 지뢰판으로 변환&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(128비트 = 128칸)&lt;/font&gt;" vertex="1">
          <mxGeometry x="0" y="200" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="비밀키" vertex="1">
          <mxGeometry x="360" y="0" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="SHA-256 해시&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(앞 128비트 사용)&lt;/font&gt;" vertex="1">
          <mxGeometry x="360" y="100" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="초기 지뢰판 B(0) 생성&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(8×16 크기, K0 = B(0))&lt;/font&gt;" vertex="1">
          <mxGeometry x="360" y="175" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="지뢰판 진화 (r = 1 … 16)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;B(r) = Evolve(Evolve(B(r-1))) ⊕ RC(r)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Evolve = MineSub ×2 → MinePerm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K(r) = B(r)&lt;/font&gt;" vertex="1">
          <mxGeometry x="360" y="250" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="라운드 키 생성&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(K0 … K16, 역순으로 사용)&lt;/font&gt;" vertex="1">
          <mxGeometry x="360" y="355" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="최종 키 제거&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(⊕ K16)&lt;/font&gt;" vertex="1">
          <mxGeometry x="165" y="510" width="220" height="50" as="geometry" />
