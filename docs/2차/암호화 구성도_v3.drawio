        </mxCell>
        <mxCell id="k4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="지뢰판 진화 (r = 1 … 16)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;B(r) = Evolve(Evolve(B(r-1))) ⊕ RC(r)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Evolve = MineSub ×2 → MinePerm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K(r) = B(r)&lt;/font&gt;" vertex="1">
