<mxfile host="app.diagrams.net">
  <diagram name="전체 구성도" id="page1-overall">
    <mxGraphModel dx="1422" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 왼쪽: 평문 처리 흐름 ===== -->
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="평문" vertex="1">
          <mxGeometry x="100" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="패딩 (PKCS#7)" vertex="1">
          <mxGeometry x="100" y="180" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="16바이트 블록 분할" vertex="1">
          <mxGeometry x="100" y="280" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="L(i)와 R(i)로 분리&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(각 8바이트)&lt;/font&gt;" vertex="1">
          <mxGeometry x="100" y="380" width="120" height="55" as="geometry" />
        </mxCell>

        <!-- 왼쪽 화살표들 -->
        <mxCell id="a1" edge="1" parent="1" source="p1" target="p2" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" parent="1" source="p2" target="p3" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" edge="1" parent="1" source="p3" target="p4" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 오른쪽: 키 처리 흐름 ===== -->
        <mxCell id="k1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="비밀키 (패스워드)" vertex="1">
          <mxGeometry x="460" y="80" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="SHA-256 해시" vertex="1">
          <mxGeometry x="460" y="180" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="지뢰 맵 생성&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(8×8, 지뢰 10개)&lt;/font&gt;" vertex="1">
          <mxGeometry x="460" y="280" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="BFS 연쇄 오픈 탐색" vertex="1">
          <mxGeometry x="460" y="380" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="라운드 키 생성&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(HMAC-SHA256 × 16)&lt;/font&gt;" vertex="1">
          <mxGeometry x="460" y="480" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- 오른쪽 화살표들 -->
        <mxCell id="ak1" edge="1" parent="1" source="k1" target="k2" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ak2" edge="1" parent="1" source="k2" target="k3" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ak3" edge="1" parent="1" source="k3" target="k4" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ak4" edge="1" parent="1" source="k4" target="k5" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 중앙: Feistel 라운드 ===== -->
        <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="라운드 1" vertex="1">
          <mxGeometry x="260" y="530" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="라운드 2" vertex="1">
          <mxGeometry x="260" y="640" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rdots" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;" value="⋮" vertex="1">
          <mxGeometry x="320" y="720" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="라운드 16" vertex="1">
          <mxGeometry x="260" y="770" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="암호문" vertex="1">
          <mxGeometry x="260" y="890" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- L/R → 라운드 1 -->
        <mxCell id="ar1" edge="1" parent="1" source="p4" target="r1" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;curved=0;rounded=0;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 키 → 라운드 1 -->
        <mxCell id="ar2" edge="1" parent="1" source="k5" target="r1" style="edgeStyle=elbowEdgeStyle;elbow=vertical;endArrow=classic;html=1;curved=0;rounded=0;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 라운드 간 화살표 -->
        <mxCell id="ar3" edge="1" parent="1" source="r1" target="r2" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar5" edge="1" parent="1" source="r16" target="ct" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 반복 화살표 -->
        <mxCell id="loop" edge="1" parent="1" source="r2" target="r1" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;curved=0;rounded=0;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="looplabel" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" value="16회 반복" vertex="1">
          <mxGeometry x="500" y="600" width="60" height="25" as="geometry" />
        </mxCell>

        <!-- 최종 스왑 라벨 -->
        <mxCell id="swaplabel" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" value="최종 스왑 (R + L)" vertex="1">
          <mxGeometry x="280" y="860" width="130" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="F함수 내부 구성도" id="page2-ffunction">
    <mxGraphModel dx="1422" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 제목 -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" value="F함수 내부 구성도" vertex="1">
          <mxGeometry x="260" y="30" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 입력: L(i)와 R(i) ===== -->
        <mxCell id="Li" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="L(i)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8바이트&lt;/font&gt;" vertex="1">
          <mxGeometry x="100" y="90" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Ri" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="R(i)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8바이트&lt;/font&gt;" vertex="1">
          <mxGeometry x="320" y="90" width="130" height="55" as="geometry" />
        </mxCell>

        <!-- 비밀키 K(i+1) -->
        <mxCell id="Ki" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="비밀키 K(i+1)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;라운드 키 8바이트&lt;/font&gt;" vertex="1">
          <mxGeometry x="540" y="200" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- ===== F함수 처리 흐름 (R(i) 쪽) ===== -->

        <!-- XOR: R(i) ⊕ K(i+1) -->
        <mxCell id="xor1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="⊕" vertex="1">
          <mxGeometry x="355" y="200" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- R(i) → XOR -->
        <mxCell id="a_ri_xor" edge="1" parent="1" source="Ri" target="xor1" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- K(i+1) → XOR -->
        <mxCell id="a_ki_xor" edge="1" parent="1" source="Ki" target="xor1" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8×8 이진 그리드 변환 -->
        <mxCell id="grid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="8×8 이진 그리드 변환&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;64비트 → 8×8 (0 또는 1)&lt;/font&gt;" vertex="1">
          <mxGeometry x="310" y="320" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a_xor_grid" edge="1" parent="1" source="xor1" target="grid" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 지뢰찾기 인접 숫자 변환 -->
        <mxCell id="adj" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="지뢰찾기 인접 숫자 변환&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1=지뢰(→0xF), 0=안전(→인접 수 0~8)&lt;/font&gt;" vertex="1">
          <mxGeometry x="290" y="430" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a_grid_adj" edge="1" parent="1" source="grid" target="adj" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- XOR 폴딩 -->
        <mxCell id="fold" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="XOR 폴딩&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;256비트 → 64비트 압축&lt;/font&gt;" vertex="1">
          <mxGeometry x="310" y="540" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a_adj_fold" edge="1" parent="1" source="adj" target="fold" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- F함수 출력 = XOR 폴딩 결과 -->
        <mxCell id="fout_label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;" value="F함수 출력 (8바이트)" vertex="1">
          <mxGeometry x="310" y="605" width="150" height="20" as="geometry" />
        </mxCell>

        <!-- ===== 최종 XOR: L(i) ⊕ F출력 ===== -->
        <mxCell id="xor2" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="⊕" vertex="1">
          <mxGeometry x="135" y="650" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- L(i) → 최종 XOR -->
        <mxCell id="a_li_xor2" edge="1" parent="1" source="Li" target="xor2" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- F출력 → 최종 XOR -->
        <mxCell id="a_fold_xor2" edge="1" parent="1" source="fold" target="xor2" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;curved=0;rounded=0;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="385" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 결과: 새 R(i+1) -->
        <mxCell id="newR" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="새 R(i+1)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;= L(i) ⊕ F(R(i), K(i+1))&lt;/font&gt;" vertex="1">
          <mxGeometry x="100" y="770" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a_xor2_newR" edge="1" parent="1" source="xor2" target="newR" style="endArrow=classic;html=1;rounded=0;endSize=6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 결과: 새 L(i+1) = R(i) 그대로 -->
        <mxCell id="newL" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="새 L(i+1)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;= R(i) 그대로&lt;/font&gt;" vertex="1">
          <mxGeometry x="320" y="770" width="130" height="55" as="geometry" />
        </mxCell>

        <!-- R(i) → 새 L(i+1) 직접 연결 -->
        <mxCell id="a_ri_newL" edge="1" parent="1" source="Ri" target="newL" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;curved=0;rounded=0;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="swap_label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" value="그대로 전달" vertex="1">
          <mxGeometry x="470" y="390" width="70" height="20" as="geometry" />
        </mxCell>

        <!-- F함수 영역 점선 박스 -->
        <mxCell id="fbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;fontSize=11;fontStyle=1;spacingTop=5;" value="F 함수 (라운드 함수)" vertex="1">
          <mxGeometry x="270" y="180" width="210" height="450" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
